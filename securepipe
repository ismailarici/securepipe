#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCAN_COMMAND="${1:-}"

# Runtime globals — set in cmd_scan after flag parsing
TARGET=""
APP_URL=""
OPENAPI_SPEC=""
AUTH_HEADER=""
REPORTS_DIR=""
RAW_DIR=""
QUIET=false

usage() {
  echo "Usage:"
  echo "  ./securepipe scan [--target <path>] [--url <url>] [--openapi <spec>] [--auth-header \"Header: Value\"] [--output-dir <path>]"
  echo "  ./securepipe org-scan [--config <securepipe-org.yml>]"
  echo "  ./securepipe report"
  echo "  ./securepipe clean"
  exit 1
}

log()     { $QUIET || echo -e "\033[1;34m[securepipe]\033[0m $*"; }
ok()      { echo -e "\033[1;32m[✓]\033[0m $*"; }
warn()    { echo -e "\033[1;33m[!]\033[0m $*"; }
fail()    { echo -e "\033[1;31m[✗]\033[0m $*"; }
section() { $QUIET || echo -e "\n\033[1;35m━━━ $* ━━━\033[0m"; }

require_docker() {
  if ! command -v docker &>/dev/null; then
    fail "Docker is required. Install Docker Desktop from https://docker.com"
    exit 1
  fi
  if ! docker info &>/dev/null; then
    fail "Docker daemon is not running. Start Docker Desktop and try again."
    exit 1
  fi
}

detect_language() {
  local dir="$1"
  if [ -f "$dir/pom.xml" ] || find "$dir" -name "build.gradle" -maxdepth 3 2>/dev/null | grep -q .; then
    echo "java"
  elif [ -f "$dir/requirements.txt" ] || find "$dir" -name "*.py" -maxdepth 3 2>/dev/null | grep -q .; then
    echo "python"
  elif [ -f "$dir/package.json" ]; then
    echo "node"
  else
    echo "unknown"
  fi
}

run_sast() {
  section "SAST — Semgrep"
  local lang
  lang=$(detect_language "$TARGET")
  log "Running Semgrep (language: $lang) ..."
  mkdir -p "$RAW_DIR"

  docker run --rm \
    -v "$TARGET:/src" \
    --workdir /src \
    returntocorp/semgrep:latest semgrep scan \
      --config auto \
      --json \
      --output /src/semgrep-results.json \
      --quiet \
      . 2>/dev/null || true

  if [ -f "$TARGET/semgrep-results.json" ]; then
    mv "$TARGET/semgrep-results.json" "$RAW_DIR/semgrep.json"
    local count
    count=$(python3 -c "import json; d=json.load(open('$RAW_DIR/semgrep.json')); print(len(d.get('results',[])))" 2>/dev/null || echo "?")
    ok "Semgrep — $count findings"
  else
    warn "Semgrep produced no output"
    echo '{"results":[]}' > "$RAW_DIR/semgrep.json"
  fi
}

run_sca() {
  section "SCA — Dependency Audit"
  local lang
  lang=$(detect_language "$TARGET")
  log "Detected language: $lang"
  mkdir -p "$RAW_DIR"

  if [ "$lang" = "python" ]; then
    log "Running pip-audit + dependency tree ..."
    docker run --rm \
      -v "$TARGET:/app" \
      --workdir /app \
      python:3.12-slim bash -c "
        pip install pip-audit pipdeptree --quiet 2>/dev/null
        pip install -r requirements.txt --quiet 2>/dev/null || true
        pip-audit -r requirements.txt --format json -o /app/pip-audit.json 2>/dev/null || true
        PKGS=\$(grep -oE '^[A-Za-z0-9_.-]+' /app/requirements.txt 2>/dev/null | tr '\\n' ',')
        [ -n \"\${PKGS%,}\" ] && pipdeptree --json-tree --packages \"\${PKGS%,}\" 2>/dev/null > /app/dep-tree.json || pipdeptree --json-tree 2>/dev/null > /app/dep-tree.json || echo '[]' > /app/dep-tree.json
        cat /app/pip-audit.json 2>/dev/null || echo '{\"dependencies\":[]}'
      " > "$RAW_DIR/sca.json" 2>/dev/null || echo '{"dependencies":[]}' > "$RAW_DIR/sca.json"
    [ -f "$TARGET/dep-tree.json" ] && mv "$TARGET/dep-tree.json" "$RAW_DIR/dep-tree.json" || true
    local count
    count=$(python3 -c "
import json
try:
    d=json.load(open('$RAW_DIR/sca.json'))
    print(sum(len(dep.get('vulns',[])) for dep in d.get('dependencies',[])))
except:
    print('?')
" 2>/dev/null || echo "?")
    ok "pip-audit — $count vulnerable packages"

  elif [ "$lang" = "node" ]; then
    log "Running npm audit ..."
    docker run --rm \
      -v "$TARGET:/app" \
      --workdir /app \
      node:20-slim bash -c "npm install --package-lock-only --quiet 2>/dev/null; npm audit --json 2>/dev/null || true" \
      > "$RAW_DIR/sca.json" 2>/dev/null || echo '{"vulnerabilities":{}}' > "$RAW_DIR/sca.json"
    ok "npm audit complete"

  elif [ "$lang" = "java" ]; then
    log "Running OWASP Dependency-Check (Java) ..."
    log "First run downloads NVD database — this may take several minutes."
    mkdir -p "$HOME/.dependency-check/data" 2>/dev/null || true
    local dc_opts="--disableAssembly --disableRetireJS"
    [ -f "$HOME/.dependency-check/data/odc.db" ] && dc_opts="$dc_opts --noupdate"
    [ -n "${NVDAPIKEY:-}" ] && dc_opts="$dc_opts --nvdApiKey $NVDAPIKEY" && log "NVD API key detected — using authenticated NVD access"
    docker run --rm \
      -v "$TARGET:/src:ro" \
      -v "$RAW_DIR:/out" \
      -v "$HOME/.dependency-check/data:/usr/share/dependency-check/data" \
      owasp/dependency-check:latest \
      --project "securepipe-scan" \
      --scan /src \
      --format JSON \
      --out /out \
      $dc_opts \
      >/dev/null 2>&1 || true
    if [ -f "$RAW_DIR/dependency-check-report.json" ]; then
      mv "$RAW_DIR/dependency-check-report.json" "$RAW_DIR/sca.json"
      ok "OWASP Dependency-Check complete"
    else
      warn "OWASP Dependency-Check produced no output (DB may still be downloading)"
      echo '{"dependencies":[]}' > "$RAW_DIR/sca.json"
    fi

  else
    warn "SCA: no supported dependency file found in $TARGET"
    echo '{}' > "$RAW_DIR/sca.json"
  fi
}

run_sbom() {
  local lang
  lang=$(detect_language "$TARGET")
  [ "$lang" = "java" ] || return 0

  section "SBOM — Syft"
  log "Generating SBOM ..."
  docker run --rm \
    -v "$TARGET:/src:ro" \
    -v "$RAW_DIR:/out" \
    anchore/syft:latest \
    /src \
    -o json=/out/sbom.json \
    2>/dev/null || true
  ok "SBOM saved to reports/raw/sbom.json"
}

run_container_scan() {
  section "Container Scan — Trivy"
  mkdir -p "$RAW_DIR"
  local dockerfile
  dockerfile=$(find "$TARGET" -name "Dockerfile" -maxdepth 3 2>/dev/null | head -1)

  if [ -z "$dockerfile" ]; then
    log "No Dockerfile found — running Trivy filesystem scan ..."
    docker run --rm \
      -v "$TARGET:/target" \
      aquasec/trivy:latest fs \
        --format json \
        --output /target/trivy.json \
        --quiet \
        /target 2>/dev/null || true
    if [ -f "$TARGET/trivy.json" ]; then
      mv "$TARGET/trivy.json" "$RAW_DIR/trivy.json"
    else
      echo '{"Results":[]}' > "$RAW_DIR/trivy.json"
    fi
    ok "Trivy filesystem scan complete"
    return
  fi

  local image_dir
  image_dir=$(dirname "$dockerfile")
  log "Building image from $dockerfile ..."
  docker build -t securepipe-scan-target:local "$image_dir" -q 2>/dev/null || {
    warn "Docker build failed — skipping container scan"
    echo '{"Results":[]}' > "$RAW_DIR/trivy.json"
    return
  }

  docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$RAW_DIR:/out" \
    aquasec/trivy:latest image \
      --format json \
      --output /out/trivy.json \
      --ignore-unfixed \
      --quiet \
      securepipe-scan-target:local 2>/dev/null || echo '{"Results":[]}' > "$RAW_DIR/trivy.json"

  local count
  count=$(python3 -c "
import json
try:
    d=json.load(open('$RAW_DIR/trivy.json'))
    print(sum(len(r.get('Vulnerabilities') or []) for r in d.get('Results',[])))
except:
    print('?')
" 2>/dev/null || echo "?")
  ok "Trivy image scan — $count vulnerabilities"
}

run_dast() {
  section "DAST — OWASP ZAP"
  mkdir -p "$RAW_DIR"

  if [ -z "$APP_URL" ] && [ -z "$OPENAPI_SPEC" ]; then
    warn "No --url or --openapi provided — skipping DAST"
    echo '{"site":[]}' > "$RAW_DIR/zap.json"
    return
  fi

  local docker_args=("docker" "run" "--rm" "-v" "$RAW_DIR:/zap/wrk")
  local zap_cmd
  local zap_args=()

  if [ -n "$OPENAPI_SPEC" ]; then
    local spec_file spec_dir spec_basename
    spec_file="$(realpath "$OPENAPI_SPEC")"
    spec_dir="$(dirname "$spec_file")"
    spec_basename="$(basename "$spec_file")"
    docker_args+=("-v" "$spec_dir:/zap/spec:ro")
    zap_cmd="zap-api-scan.py"
    zap_args=("-t" "/zap/spec/$spec_basename" "-f" "openapi" "-J" "zap.json" "-I")
    log "OpenAPI-driven scan: $spec_basename"
  else
    zap_cmd="zap-baseline.py"
    zap_args=("-t" "$APP_URL" "-J" "zap.json" "-I")
    log "Baseline scan: $APP_URL"
  fi

  if [ -n "$AUTH_HEADER" ]; then
    local header_name header_value
    header_name="$(echo "$AUTH_HEADER" | cut -d: -f1 | xargs)"
    header_value="$(echo "$AUTH_HEADER" | cut -d: -f2- | xargs)"
    local zap_config="-config replacer.full_list(0).description=securepipe-auth -config replacer.full_list(0).enabled=true -config replacer.full_list(0).matchtype=REQ_HEADER -config replacer.full_list(0).matchstr=${header_name} -config replacer.full_list(0).replacement=${header_value}"
    zap_args+=("-z" "$zap_config")
    ok "Authenticated DAST enabled (header: $header_name)"
  fi

  log "Running ZAP scan ..."
  "${docker_args[@]}" ghcr.io/zaproxy/zaproxy:stable "$zap_cmd" "${zap_args[@]}" 2>/dev/null || true
  ok "ZAP scan complete"
}

run_imports() {
  log "Scanning source for import statements ..."
  python3 "$SCRIPT_DIR/scripts/find-imports.py" \
    --source-dir "$TARGET" \
    --output "$RAW_DIR/imports.json" 2>/dev/null || true
}

generate_report() {
  section "Report Generation"
  log "Generating security-report.html ..."
  python3 "$SCRIPT_DIR/scripts/generate-report.py" \
    --raw-dir "$RAW_DIR" \
    --output "$REPORTS_DIR/security-report.html"
  ok "Report: $REPORTS_DIR/security-report.html"
  $QUIET || echo ""
  $QUIET || log "Open with: open \"$REPORTS_DIR/security-report.html\""
}

cmd_scan() {
  shift || true
  TARGET="$SCRIPT_DIR"
  APP_URL=""
  OPENAPI_SPEC=""
  AUTH_HEADER=""
  local output_dir=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)      TARGET="$2";       shift 2 ;;
      --url)         APP_URL="$2";      shift 2 ;;
      --openapi)     OPENAPI_SPEC="$2"; shift 2 ;;
      --auth-header) AUTH_HEADER="$2";  shift 2 ;;
      --output-dir)  output_dir="$2";   QUIET=true; shift 2 ;;
      *)             usage ;;
    esac
  done

  TARGET="$(realpath "$TARGET")"
  local resolved_reports="${output_dir:-$SCRIPT_DIR/reports}"
  mkdir -p "$resolved_reports"
  REPORTS_DIR="$(realpath "$resolved_reports")"
  RAW_DIR="$REPORTS_DIR/raw"
  mkdir -p "$RAW_DIR"

  if ! $QUIET; then
    echo ""
    echo "  ███████╗███████╗ ██████╗██╗   ██╗██████╗ ███████╗██████╗ ██╗██████╗ ███████╗"
    echo "  ██╔════╝██╔════╝██╔════╝██║   ██║██╔══██╗██╔════╝██╔══██╗██║██╔══██╗██╔════╝"
    echo "  ███████╗█████╗  ██║     ██║   ██║██████╔╝█████╗  ██████╔╝██║██████╔╝█████╗  "
    echo "  ╚════██║██╔══╝  ██║     ██║   ██║██╔══██╗██╔══╝  ██╔═══╝ ██║██╔═══╝ ██╔══╝  "
    echo "  ███████║███████╗╚██████╗╚██████╔╝██║  ██║███████╗██║     ██║██║     ███████╗"
    echo "  ╚══════╝╚══════╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═╝     ╚═╝╚═╝     ╚══════╝"
    echo ""
    log "Target: $TARGET"
    [ -n "$APP_URL" ] && log "DAST target: $APP_URL"
    [ -n "$OPENAPI_SPEC" ] && log "OpenAPI spec: $OPENAPI_SPEC"
    echo ""
  fi

  require_docker
  run_sast
  run_sca
  run_imports
  run_sbom
  run_container_scan
  run_dast
  generate_report

  if ! $QUIET; then
    echo ""
    echo -e "\033[1;32m━━━ Scan complete ━━━\033[0m"
    echo ""
  fi
}

cmd_org_scan() {
  shift || true
  local config_file="securepipe-org.yml"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config) config_file="$2"; shift 2 ;;
      *) usage ;;
    esac
  done

  if [ ! -f "$config_file" ]; then
    fail "Config file not found: $config_file"
    fail "Create one or use examples/securepipe-org.yml as a template"
    exit 1
  fi

  require_docker
  python3 -u "$SCRIPT_DIR/scripts/org-scan.py" \
    --config "$(realpath "$config_file")" \
    --securepipe "$SCRIPT_DIR/securepipe"
}

cmd_report() {
  REPORTS_DIR="$SCRIPT_DIR/reports"
  RAW_DIR="$REPORTS_DIR/raw"
  if [ ! -d "$RAW_DIR" ]; then
    fail "No scan data found. Run './securepipe scan' first."
    exit 1
  fi
  python3 "$SCRIPT_DIR/scripts/generate-report.py" \
    --raw-dir "$RAW_DIR" \
    --output "$REPORTS_DIR/security-report.html"
  ok "Report: $REPORTS_DIR/security-report.html"
}

cmd_clean() {
  log "Cleaning scan artifacts ..."
  rm -rf "$SCRIPT_DIR/reports"
  docker rmi securepipe-scan-target:local 2>/dev/null || true
  ok "Clean complete"
}

case "$SCAN_COMMAND" in
  scan)      cmd_scan "$@" ;;
  org-scan)  cmd_org_scan "$@" ;;
  report)    cmd_report ;;
  clean)     cmd_clean ;;
  *)         usage ;;
esac
