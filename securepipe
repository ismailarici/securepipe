#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPORTS_DIR="$SCRIPT_DIR/reports"
RAW_DIR="$REPORTS_DIR/raw"
TARGET="${TARGET:-$SCRIPT_DIR}"
APP_URL=""
SCAN_COMMAND="${1:-}"

usage() {
  echo "Usage:"
  echo "  ./securepipe scan [--target <path>] [--url <http://host:port>]"
  echo "  ./securepipe report"
  echo "  ./securepipe clean"
  echo ""
  echo "Examples:"
  echo "  ./securepipe scan"
  echo "  ./securepipe scan --target ./sample-apps/python"
  echo "  ./securepipe scan --url http://localhost:5000"
  exit 1
}

log()  { echo -e "\033[1;34m[securepipe]\033[0m $*"; }
ok()   { echo -e "\033[1;32m[✓]\033[0m $*"; }
warn() { echo -e "\033[1;33m[!]\033[0m $*"; }
fail() { echo -e "\033[1;31m[✗]\033[0m $*"; }
section() { echo -e "\n\033[1;35m━━━ $* ━━━\033[0m"; }

require_docker() {
  if ! command -v docker &>/dev/null; then
    fail "Docker is required but not installed. Install Docker Desktop from https://docker.com"
    exit 1
  fi
  if ! docker info &>/dev/null; then
    fail "Docker daemon is not running. Start Docker Desktop and try again."
    exit 1
  fi
}

detect_language() {
  local dir="$1"
  if [ -f "$dir/requirements.txt" ] || find "$dir" -name "*.py" -maxdepth 3 | grep -q .; then
    echo "python"
  elif [ -f "$dir/package.json" ]; then
    echo "node"
  elif find "$dir" -name "pom.xml" -o -name "build.gradle" -maxdepth 3 | grep -q .; then
    echo "java"
  else
    echo "unknown"
  fi
}

run_sast() {
  section "SAST — Semgrep"
  log "Running Semgrep on $TARGET ..."
  mkdir -p "$RAW_DIR"
  docker run --rm \
    -v "$TARGET:/src" \
    --workdir /src \
    returntocorp/semgrep:latest semgrep scan \
      --config auto \
      --json \
      --output /src/semgrep-results.json \
      --quiet \
      . 2>/dev/null || true
  if [ -f "$TARGET/semgrep-results.json" ]; then
    mv "$TARGET/semgrep-results.json" "$RAW_DIR/semgrep.json"
    local count
    count=$(python3 -c "import json,sys; d=json.load(open('$RAW_DIR/semgrep.json')); print(len(d.get('results',[])))" 2>/dev/null || echo "?")
    ok "Semgrep complete — $count findings"
  else
    warn "Semgrep produced no output"
    echo '{"results":[]}' > "$RAW_DIR/semgrep.json"
  fi
}

run_sca() {
  section "SCA — Dependency Audit"
  local lang
  lang=$(detect_language "$TARGET")
  log "Detected language: $lang"
  mkdir -p "$RAW_DIR"

  if [ "$lang" = "python" ]; then
    log "Running pip-audit ..."
    docker run --rm \
      -v "$TARGET:/app" \
      --workdir /app \
      python:3.12-slim bash -c "
        pip install pip-audit --quiet 2>/dev/null
        pip-audit -r requirements.txt --format json -o /app/pip-audit.json 2>/dev/null || true
        cat /app/pip-audit.json 2>/dev/null || echo '{\"dependencies\":[]}'
      " > "$RAW_DIR/sca.json" 2>/dev/null || echo '{"dependencies":[]}' > "$RAW_DIR/sca.json"
    local count
    count=$(python3 -c "
import json, sys
try:
    d = json.load(open('$RAW_DIR/sca.json'))
    vulns = sum(len(dep.get('vulns',[])) for dep in d.get('dependencies',[]))
    print(vulns)
except:
    print('?')
" 2>/dev/null || echo "?")
    ok "pip-audit complete — $count vulnerable packages"

  elif [ "$lang" = "node" ]; then
    log "Running npm audit ..."
    docker run --rm \
      -v "$TARGET:/app" \
      --workdir /app \
      node:20-slim bash -c "npm audit --json 2>/dev/null || true" > "$RAW_DIR/sca.json" 2>/dev/null || echo '{"vulnerabilities":{}}' > "$RAW_DIR/sca.json"
    ok "npm audit complete"

  else
    warn "SCA: no supported dependency file found in $TARGET"
    echo '{}' > "$RAW_DIR/sca.json"
  fi
}

run_container_scan() {
  section "Container Scan — Trivy"
  mkdir -p "$RAW_DIR"
  local dockerfile
  dockerfile=$(find "$TARGET" -name "Dockerfile" -maxdepth 3 | head -1)

  if [ -z "$dockerfile" ]; then
    log "No Dockerfile found — running Trivy filesystem scan ..."
    docker run --rm \
      -v "$TARGET:/target" \
      aquasec/trivy:latest fs \
        --format json \
        --output /target/trivy.json \
        --quiet \
        /target 2>/dev/null || true
    if [ -f "$TARGET/trivy.json" ]; then
      mv "$TARGET/trivy.json" "$RAW_DIR/trivy.json"
    else
      echo '{"Results":[]}' > "$RAW_DIR/trivy.json"
    fi
    ok "Trivy filesystem scan complete"
    return
  fi

  local image_dir
  image_dir=$(dirname "$dockerfile")
  log "Building image from $dockerfile ..."
  docker build -t securepipe-scan-target:local "$image_dir" -q 2>/dev/null || {
    warn "Docker build failed — skipping container scan"
    echo '{"Results":[]}' > "$RAW_DIR/trivy.json"
    return
  }

  docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock \
    aquasec/trivy:latest image \
      --format json \
      --output /tmp/trivy.json \
      --ignore-unfixed \
      --quiet \
      securepipe-scan-target:local 2>/dev/null || true

  docker run --rm \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$RAW_DIR:/out" \
    aquasec/trivy:latest image \
      --format json \
      --output /out/trivy.json \
      --ignore-unfixed \
      --quiet \
      securepipe-scan-target:local 2>/dev/null || echo '{"Results":[]}' > "$RAW_DIR/trivy.json"

  local count
  count=$(python3 -c "
import json
try:
    d = json.load(open('$RAW_DIR/trivy.json'))
    vulns = sum(len(r.get('Vulnerabilities') or []) for r in d.get('Results',[]))
    print(vulns)
except:
    print('?')
" 2>/dev/null || echo "?")
  ok "Trivy image scan complete — $count vulnerabilities"
}

run_dast() {
  section "DAST — OWASP ZAP"
  mkdir -p "$RAW_DIR"

  if [ -z "$APP_URL" ]; then
    warn "No --url provided — skipping DAST. Use: ./securepipe scan --url http://localhost:5000"
    echo '{"site":[]}' > "$RAW_DIR/zap.json"
    return
  fi

  log "Running ZAP baseline scan against $APP_URL ..."
  docker run --rm \
    -v "$RAW_DIR:/zap/wrk" \
    ghcr.io/zaproxy/zaproxy:stable zap-baseline.py \
      -t "$APP_URL" \
      -J zap.json \
      -I 2>/dev/null || true

  ok "ZAP scan complete"
}

generate_report() {
  section "Report Generation"
  log "Generating security-report.html ..."
  python3 "$SCRIPT_DIR/scripts/generate-report.py" \
    --raw-dir "$RAW_DIR" \
    --output "$REPORTS_DIR/security-report.html"
  ok "Report saved to: reports/security-report.html"
  echo ""
  log "Open with: open reports/security-report.html"
}

cmd_scan() {
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target) TARGET="$2"; shift 2 ;;
      --url)    APP_URL="$2"; shift 2 ;;
      *)        usage ;;
    esac
  done

  TARGET="$(realpath "$TARGET")"

  echo ""
  echo "  ███████╗███████╗ ██████╗██╗   ██╗██████╗ ███████╗██████╗ ██╗██████╗ ███████╗"
  echo "  ██╔════╝██╔════╝██╔════╝██║   ██║██╔══██╗██╔════╝██╔══██╗██║██╔══██╗██╔════╝"
  echo "  ███████╗█████╗  ██║     ██║   ██║██████╔╝█████╗  ██████╔╝██║██████╔╝█████╗  "
  echo "  ╚════██║██╔══╝  ██║     ██║   ██║██╔══██╗██╔══╝  ██╔═══╝ ██║██╔═══╝ ██╔══╝  "
  echo "  ███████║███████╗╚██████╗╚██████╔╝██║  ██║███████╗██║     ██║██║     ███████╗"
  echo "  ╚══════╝╚══════╝ ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═╝     ╚═╝╚═╝     ╚══════╝"
  echo ""
  log "Target: $TARGET"
  [ -n "$APP_URL" ] && log "DAST target: $APP_URL"
  echo ""

  require_docker
  mkdir -p "$RAW_DIR"

  run_sast
  run_sca
  run_container_scan
  run_dast
  generate_report

  echo ""
  echo -e "\033[1;32m━━━ Scan complete ━━━\033[0m"
  echo ""
}

cmd_report() {
  if [ ! -d "$RAW_DIR" ]; then
    fail "No scan data found. Run './securepipe scan' first."
    exit 1
  fi
  python3 "$SCRIPT_DIR/scripts/generate-report.py" \
    --raw-dir "$RAW_DIR" \
    --output "$REPORTS_DIR/security-report.html"
  ok "Report saved to: reports/security-report.html"
}

cmd_clean() {
  log "Cleaning scan artifacts ..."
  rm -rf "$REPORTS_DIR"
  docker rmi securepipe-scan-target:local 2>/dev/null || true
  ok "Clean complete"
}

case "$SCAN_COMMAND" in
  scan)   cmd_scan "$@" ;;
  report) cmd_report ;;
  clean)  cmd_clean ;;
  *)      usage ;;
esac
